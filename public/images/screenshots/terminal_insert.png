<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 800 500" fill="none">
  <!-- Outer Frame -->
  <rect width="800" height="500" rx="10" fill="#0F172A"/>
  <!-- Top Bar -->
  <rect width="800" height="42" rx="10" fill="#1E293B"/>
  <rect y="32" width="800" height="10" fill="#1E293B"/>
  <circle cx="25" cy="21" r="6" fill="#EF4444"/>
  <circle cx="45" cy="21" r="6" fill="#F59E0B"/>
  <circle cx="65" cy="21" r="6" fill="#10B981"/>
  <text x="400" y="26" font-family="'JetBrains Mono', monospace" font-size="12" fill="#94A3B8" text-anchor="middle" font-weight="600">PocketSQL Transaction Manager — ACID Validation</text>

  <g transform="translate(30, 65)">
    <!-- SQL Transaction Block -->
    <text x="0" y="20" font-family="'JetBrains Mono', monospace" font-size="13" fill="#10B981" font-weight="600">pocketsql&gt;</text>
    <text x="90" y="20" font-family="'JetBrains Mono', monospace" font-size="13" fill="#38BDF8">START TRANSACTION;</text>
    <text x="0" y="42" font-family="'JetBrains Mono', monospace" font-size="12" fill="#94A3B8">Query OK, 0 rows affected (0.12 ms)</text>

    <text x="0" y="80" font-family="'JetBrains Mono', monospace" font-size="13" fill="#10B981" font-weight="600">pocketsql&gt;</text>
    <text x="90" y="80" font-family="'JetBrains Mono', monospace" font-size="13" fill="#F8FAFC">INSERT INTO orders (customer_id, total, status) VALUES (42, 289.50, 'PAID');</text>
    <text x="0" y="102" font-family="'JetBrains Mono', monospace" font-size="12" fill="#10B981">Query OK, 1 row affected (0.45 ms) — Generated ID: 10892</text>

    <text x="0" y="140" font-family="'JetBrains Mono', monospace" font-size="13" fill="#10B981" font-weight="600">pocketsql&gt;</text>
    <text x="90" y="140" font-family="'JetBrains Mono', monospace" font-size="13" fill="#F8FAFC">UPDATE inventory SET stock = stock - 1 WHERE product_id = 101;</text>
    <text x="0" y="162" font-family="'JetBrains Mono', monospace" font-size="12" fill="#10B981">Query OK, 1 row affected (0.38 ms) — Rows matched: 1  Changed: 1</text>

    <text x="0" y="200" font-family="'JetBrains Mono', monospace" font-size="13" fill="#10B981" font-weight="600">pocketsql&gt;</text>
    <text x="90" y="200" font-family="'JetBrains Mono', monospace" font-size="13" fill="#38BDF8">COMMIT;</text>
    <text x="0" y="222" font-family="'JetBrains Mono', monospace" font-size="12" fill="#10B981">Query OK, 0 rows affected (0.91 ms) — WAL Sync Confirmed [AES-256 Checksum OK]</text>

    <!-- Visual Constraint Status Card -->
    <rect x="0" y="250" width="740" height="150" rx="6" fill="#1E293B" stroke="#334155"/>
    <text x="25" y="280" font-family="'JetBrains Mono', monospace" font-size="13" fill="#F8FAFC" font-weight="600">Storage &amp; Integrity Verification Status:</text>
    
    <g transform="translate(25, 305)">
      <circle cx="6" cy="6" r="6" fill="#10B981"/>
      <text x="22" y="10" font-family="'JetBrains Mono', monospace" font-size="12" fill="#CBD5E1">Foreign Key `fk_orders_customer` : Validated</text>
      
      <circle cx="6" cy="30" r="6" fill="#10B981"/>
      <text x="22" y="34" font-family="'JetBrains Mono', monospace" font-size="12" fill="#CBD5E1">Check Constraint `chk_stock_positive` : Passed (stock &gt;= 0)</text>

      <circle cx="6" cy="54" r="6" fill="#10B981"/>
      <text x="22" y="58" font-family="'JetBrains Mono', monospace" font-size="12" fill="#CBD5E1">Write-Ahead Log (WAL) Flush : Completed to Internal App Storage</text>
    </g>
  </g>
</svg>
